# Port to listen on (Render automatically provides PORT in production)
PORT=5000

# Node environment (development or production)
NODE_ENV=development

# Secret key used for signing and verifying JWT tokens (Use 64-char hex string in production)
JWT_SECRET=replace_with_a_secure_random_secret

# MongoDB connection URI (MongoDB Atlas connection string in production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smarthome?retryWrites=true&w=majority

# Frontend origin allowed for CORS (e.g. deployed Vercel URL)
FRONTEND_URL=https://fsd-project-bice.vercel.app
